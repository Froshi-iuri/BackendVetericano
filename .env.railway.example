# Variables recomendadas para BackendVetericano en Railway.
# OBLIGATORIA: SECRET_KEY aleatoria (>= 50 caracteres, sin prefijo "django-insecure-"), idéntica en
# BackendVetericano y vetericano-ws (recomendado: variable compartida del proyecto). Sin ella, o con la
# clave pública de desarrollo, el servicio no arranca. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=REEMPLAZAR_CON_CLAVE_ALEATORIA
# Activar DUPLICADOS_IA_DINOV2_ACTIVA y DUPLICADOS_DINOV2_CACHE_BD_ACTIVA cuando VetericanoIA esté activo (0007+ aplicada).
DUPLICADOS_IA_DINOV2_ACTIVA=True
DUPLICADOS_DINOV2_BACKEND=microservicio
DUPLICADOS_DINOV2_MICROSERVICIO_URL=http://vetericanoia.railway.internal:8001
DUPLICADOS_DINOV2_MICROSERVICIO_SECRET=REEMPLAZAR_CON_EL_MISMO_SECRETO_64_HEX_DE_VETERIANOIA
DUPLICADOS_DINOV2_MICROSERVICIO_TIMEOUT_SEGUNDOS=8.0
DUPLICADOS_DINOV2_CACHE_BD_ACTIVA=True
DUPLICADOS_DINOV2_FALLBACK_DHASH=True
DUPLICADOS_UMBRAL_DINOV2=0.45
DUPLICADOS_RADIO_GPS_METROS=200.0
DUPLICADOS_DINOV2_MODEL_NAME=facebook/dinov2-small
DUPLICADOS_DINOV2_DEVICE=cpu
