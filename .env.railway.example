# Variables recomendadas para BackendVetericano en Railway.
# OBLIGATORIA: SECRET_KEY aleatoria (>= 50 caracteres, sin prefijo "django-insecure-"), idéntica en
# BackendVetericano y vetericano-ws (recomendado: variable compartida del proyecto). Sin ella, o con la
# clave pública de desarrollo, el servicio no arranca. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=REEMPLAZAR_CON_CLAVE_ALEATORIA
# Activar DUPLICADOS_IA_DINOV2_ACTIVA y DUPLICADOS_DINOV2_CACHE_BD_ACTIVA cuando VetericanoIA esté activo (0007+ aplicada).
DUPLICADOS_IA_DINOV2_ACTIVA=True
DUPLICADOS_DINOV2_BACKEND=microservicio
DUPLICADOS_DINOV2_MICROSERVICIO_URL=http://vetericanoia.railway.internal:8001
DUPLICADOS_DINOV2_MICROSERVICIO_SECRET=REEMPLAZAR_CON_EL_MISMO_SECRETO_64_HEX_DE_VETERIANOIA
DUPLICADOS_DINOV2_MICROSERVICIO_TIMEOUT_SEGUNDOS=8.0
DUPLICADOS_DINOV2_CACHE_BD_ACTIVA=True
DUPLICADOS_DINOV2_FALLBACK_DHASH=True
DUPLICADOS_UMBRAL_DINOV2=0.45
DUPLICADOS_RADIO_GPS_METROS=200.0
DUPLICADOS_DINOV2_MODEL_NAME=facebook/dinov2-small
DUPLICADOS_DINOV2_DEVICE=cpu

# ─── Triaje Inteligente IA (orquestación con n8n en Railway) ─────────────────────────────
# Mantener TRIAJE_N8N_ACTIVO=False hasta aplicar `python manage.py migrate triaje_ia`
# y desplegar el servicio n8n en Railway con sus credenciales de producción.
TRIAJE_N8N_ACTIVO=False
# Con Serverless ON (App Sleeping) en n8n, usar el dominio público HTTPS para garantizar
# el wake-up del Edge Proxy ante arranque en frío; si Serverless estuviera OFF, puede usarse
# http://n8n.railway.internal:5678/webhook/vetericano-triaje-peticion
TRIAJE_N8N_WEBHOOK_URL=https://REEMPLAZAR_CON_DOMINIO_N8N.up.railway.app/webhook/vetericano-triaje-peticion
# Generar secretos independientes para producción (ej. python -c "import secrets; print(secrets.token_urlsafe(48))"):
TRIAJE_N8N_WEBHOOK_SECRET=REEMPLAZAR_CON_SECRETO_WEBHOOK_PRODUCCION
TRIAJE_SERVICE_TOKEN=REEMPLAZAR_CON_TOKEN_SERVICIO_PRODUCCION
TRIAJE_AISLAR_POR_SEDE=True
TRIAJE_N8N_TIMEOUT_SEGUNDOS=20.0
TRIAJE_N8N_MAX_REINTENTOS=6
TRIAJE_N8N_BACKOFF_BASE_SEGUNDOS=30.0
TRIAJE_N8N_BACKOFF_MAX_SEGUNDOS=900.0
TRIAJE_ANALISIS_TIMEOUT_SEGUNDOS=300.0
TRIAJE_RECOVERY_INTERVAL_SEGUNDOS=30.0
TRIAJE_RECOVERY_IN_PROCESS=True
# Mantener False: el workflow de demostración usa solo la imagen sintética generada por Django.
TRIAJE_ENVIAR_URLS_EXTERNAS_N8N=False
# Usar True durante la demo autorizada para habilitar la imagen sintética. El valor por defecto es False.
TRIAJE_GEMINI_ENVIAR_FOTOS=False
# Mantener False con Gemini gratuito. La demo requiere el comando interno y el escenario exacto.
TRIAJE_GEMINI_PERMITIR_DENUNCIAS_REALES=False
# Opcional: restringe los IDs que el comando puede autorizar. La lista sola no concede acceso.
TRIAJE_GEMINI_IDS_PRUEBA_PERMITIDOS=
