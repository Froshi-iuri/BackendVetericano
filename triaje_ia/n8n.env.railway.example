# Variables para ejecutar n8n en Railway con Serverless ON (App Sleeping) + SQLite + Volumen
# Imagen recomendada: n8nio/n8n:2.49.7
# Volumen persistente obligatorio: montar en /home/node/.n8n (1 sola réplica, Serverless ON)

DB_TYPE=sqlite
DB_SQLITE_POOL_SIZE=3
DB_SQLITE_VACUUM_ON_STARTUP=false
N8N_USER_FOLDER=/home/node/.n8n

# IMPORTANTE: generar una clave fija y respaldarla fuera de Railway. Si se pierde,
# las credenciales almacenadas en n8n quedan irrecuperables.
#   python -c "import secrets; print(secrets.token_hex(32))"
N8N_ENCRYPTION_KEY=REEMPLAZAR_CON_CLAVE_HEX_DE_64_CARACTERES

PORT=5678
N8N_PORT=5678
N8N_LISTEN_ADDRESS=::
RAILWAY_RUN_UID=0

# En Railway, ${{RAILWAY_PUBLIC_DOMAIN}} resuelve al dominio HTTPS del servicio n8n
N8N_EDITOR_BASE_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}
N8N_WEBHOOK_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}
N8N_PROXY_HOPS=2
N8N_EXPRESS_TRUST_PROXY=true
N8N_SECURE_COOKIE=true

GENERIC_TIMEZONE=America/Bogota
TZ=America/Bogota

# Retención y privacidad para denuncias reales y ahorro de almacenamiento en el volumen SQLite
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168
EXECUTIONS_DATA_PRUNE_MAX_COUNT=1000
EXECUTIONS_DATA_SAVE_ON_SUCCESS=none
EXECUTIONS_DATA_SAVE_ON_ERROR=none
EXECUTIONS_DATA_SAVE_ON_PROGRESS=false
EXECUTIONS_DATA_SAVE_MANUAL_EXECUTIONS=false

# Apagar toda telemetría y tráfico saliente en segundo plano para permitir suspensión Serverless
N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
N8N_TEMPLATES_ENABLED=false
N8N_ONBOARDING_FLOW_DISABLED=true
N8N_HIRING_BANNER_ENABLED=false
EXTERNAL_FRONTEND_HOOKS_URLS=
N8N_DIAGNOSTICS_CONFIG_FRONTEND=
N8N_DIAGNOSTICS_CONFIG_BACKEND=
