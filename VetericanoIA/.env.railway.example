# Plantilla de variables para el servicio privado VetericanoIA en Railway Hobby.
# NO incluir secretos reales en este archivo ni generar dominio público para este servicio.
PORT=8001
IA_HOST=::
IA_INTERNAL_SHARED_SECRET=REEMPLAZAR_CON_SECRETO_64_HEX_ALEATORIO
IA_MODEL_NAME=facebook/dinov2-small
IA_DEVICE=cpu
IA_MAX_IMAGE_BYTES=2097152
IA_MIN_DIMENSION_PX=16
IA_MAX_IMAGE_PIXELS=16000000
IA_MAX_CONCURRENT_INFERENCES=1
IA_MAX_PENDING_QUEUE=4
IA_MAX_QUEUE_WAIT_SECONDS=4.0
IA_PRELOAD_MODEL=true
