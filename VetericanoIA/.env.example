# Configuración de ejemplo para VetericanoIA (NO versionar archivos .env reales).
# Generar un secreto fuerte compartido con BackendVetericano (ej. openssl rand -hex 32).
IA_INTERNAL_SHARED_SECRET=
IA_MODEL_NAME=facebook/dinov2-small
IA_DEVICE=cpu
IA_MAX_IMAGE_BYTES=2097152
IA_MIN_DIMENSION_PX=16
IA_MAX_IMAGE_PIXELS=16000000
IA_MAX_CONCURRENT_INFERENCES=1
IA_MAX_PENDING_QUEUE=4
IA_MAX_QUEUE_WAIT_SECONDS=4.0
IA_PRELOAD_MODEL=true
# Local: 127.0.0.1:8001. En Railway se resuelve automáticamente "::" y $PORT si IA_HOST/IA_PORT no están definidos.
IA_HOST=127.0.0.1
IA_PORT=8001
